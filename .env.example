# Copy this file to .env and fill in your values before running docker compose up.

# PostgreSQL
POSTGRES_USER=scenarai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=scenarai

# Redis
REDIS_PASSWORD=changeme

# Backend
DATABASE_URL=postgresql+asyncpg://scenarai:changeme@postgres:5432/scenarai
REDIS_URL=redis://:changeme@redis:6379/0

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_random_secret

# Groq API key — get one at console.groq.com
GROQ_API_KEY=

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost,http://localhost:3000
