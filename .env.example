# Copy this file to .env and set each required secret before running Compose.

POSTGRES_USER=scenarai
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
GROQ_API_KEY=

# Temporary Cloudflare Quick Tunnel portfolio profile.
MEDIA_ENABLED=false
VITE_MEDIA_ENABLED=false
VITE_DISABLE_SSE=true
CORS_ORIGINS=http://localhost

# Compose derives DATABASE_URL and REDIS_URL from the credentials above.
# Set VITE_DISABLE_SSE=false only when serving through a host that supports SSE.
